# Settings for deploy/azure/deploy.sh. Copy to deploy/azure/test.env and edit.

# Short lowercase prefix for all resource and app names (3-12 characters).
PREFIX=aotest
# Optional: subscription to use (default: the current az account).
SUBSCRIPTION_ID=
LOCATION=switzerlandnorth
RESOURCE_GROUP=rg-aotest

# Let's Encrypt account email for the public certificates (ingress and LiveKit).
ACME_EMAIL=you@example.com

# Optional: comma-separated UPNs of testers who get all test roles
# (assurance standard + stepup, command center viewer/operator/investigator/approver).
# The person running the deployment always gets them. Four-eyes changes need two people.
TEST_USERS=

# Optional: restrict the public endpoints to these source ranges (comma-separated CIDRs).
ALLOWED_SOURCE_RANGES=
# Optional: allow SSH to the LiveKit VM from this range (e.g. your IP/32). Empty: no SSH.
SSH_SOURCE_CIDR=

# Optional overrides. DNS labels default to <prefix>-app-<hash> and <prefix>-lk-<hash>.
APP_DNS_LABEL=
LIVEKIT_DNS_LABEL=
# VM sizes: both must belong to a VM family with vCPU quota in LOCATION (the deploy checks first).
AKS_NODE_SIZE=Standard_D4s_v5
# LiveKit server VM size (2 vCPU is enough for a few test calls).
LIVEKIT_VM_SIZE=Standard_D2s_v5
# Set to 1 to reuse the last built images (configuration-only change).
SKIP_BUILD=0
