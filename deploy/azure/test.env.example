# Settings for deploy/azure/deploy.sh. Copy to deploy/azure/test.env and edit.

# Short lowercase prefix for all resource and app names (3-12 letters or digits).
PREFIX=aotest
# Optional: subscription to use (default: the current az account).
SUBSCRIPTION_ID=
LOCATION=switzerlandnorth
RESOURCE_GROUP=rg-aotest

# Let's Encrypt account email for the public certificate.
ACME_EMAIL=you@example.com

# Optional: comma-separated UPNs of testers who get all test roles
# (assurance standard + stepup, command center viewer/operator/investigator/approver).
# The person running the deployment always gets them. Four-eyes changes need two people.
TEST_USERS=

# Optional: restrict the web endpoints to these source ranges (comma-separated CIDRs).
ALLOWED_SOURCE_RANGES=
# Optional: allow SSH to the VM from this range (e.g. your IP/32). Empty: no SSH.
SSH_SOURCE_CIDR=

# Optional: DNS label of the VM; default <prefix>-app-<hash> -> <label>.<region>.cloudapp.azure.com
DNS_LABEL=
# VM size: needs vCPU quota for its family in LOCATION (the deploy checks first).
# 4 vCPUs / 16 GiB run everything including voice; see docs/AZURE_TEST_ENV.md for alternatives.
VM_SIZE=Standard_D4s_v5
# Set to 1 to reuse the last built images (configuration-only change).
SKIP_BUILD=0
